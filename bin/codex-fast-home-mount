#!/usr/bin/env bash
set -euo pipefail

OWNER_USER="${CODEX_OWNER_USER:-${SUDO_USER:-$USER}}"
WIN_CODEX_HOME="${WIN_CODEX_HOME:-/mnt/c/Users/${OWNER_USER}/.codex}"
FAST_CODEX_HOME="${FAST_CODEX_HOME:-/home/${OWNER_USER}/.codex-desktop-fast}"
OWNER_GROUP="$(id -gn "$OWNER_USER")"

log() {
	echo "[codex-fast-home-mount] $*"
}

if [[ $EUID -ne 0 ]]; then
	echo "codex-fast-home-mount must run as root." >&2
	exit 1
fi

if [[ ! -d "$(dirname "$WIN_CODEX_HOME")" ]]; then
	echo "Windows home is not mounted yet: $(dirname "$WIN_CODEX_HOME")" >&2
	exit 1
fi

install -d -o "$OWNER_USER" -g "$OWNER_GROUP" -m 0775 "$FAST_CODEX_HOME"
install -d -o "$OWNER_USER" -g "$OWNER_GROUP" -m 0775 "$WIN_CODEX_HOME"

# If the target is already mounted, accept only the expected source.
# This prevents accidental duplicate/stacked bind mounts.
if mountpoint -q "$WIN_CODEX_HOME"; then
	if findmnt -rn --target "$WIN_CODEX_HOME" -o SOURCE | grep -Fq "$FAST_CODEX_HOME"; then
		log "Already mounted: $FAST_CODEX_HOME -> $WIN_CODEX_HOME"
		exit 0
	fi

	echo "Target is already mounted from an unexpected source: $WIN_CODEX_HOME" >&2
	findmnt -T "$WIN_CODEX_HOME" >&2
	exit 1
fi

# Keep Codex Desktop's changing WSL runtime/hash folders aligned before mounting.
log "Syncing Windows .codex -> fast ext4 mirror..."
rsync -a --delete --chown="$OWNER_USER:$OWNER_GROUP" \
	"$WIN_CODEX_HOME"/ \
	"$FAST_CODEX_HOME"/

log "Bind mounting fast mirror..."
mount --bind "$FAST_CODEX_HOME" "$WIN_CODEX_HOME"

log "Mounted successfully:"
findmnt -T "$WIN_CODEX_HOME" -o TARGET,SOURCE,FSTYPE
