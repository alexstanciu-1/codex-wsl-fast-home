#!/usr/bin/env bash
set -euo pipefail

SERVICE_FILE="${CODEX_FAST_HOME_SERVICE:-/etc/systemd/system/codex-fast-home.service}"

service_env() {
	local name="$1"
	if [[ -r "$SERVICE_FILE" ]]; then
		sed -n "s#^Environment=${name}=##p" "$SERVICE_FILE" | tail -n 1
	fi
}

DEFAULT_OWNER_USER="${SUDO_USER:-$USER}"
if [[ "$DEFAULT_OWNER_USER" == "root" ]]; then
	DEFAULT_OWNER_USER="$(service_env CODEX_OWNER_USER)"
fi

OWNER_USER="${CODEX_OWNER_USER:-${DEFAULT_OWNER_USER:-$USER}}"
if [[ -z "$OWNER_USER" || "$OWNER_USER" == "root" ]]; then
	cat >&2 <<'MSG'
Refusing to use "root" as the Codex fast-home owner.

Reinstall the service from your normal WSL user with:
  sudo ./install.sh

Or set CODEX_OWNER_USER=<wsl-user> when running this helper.
MSG
	exit 1
fi

WIN_CODEX_HOME="${WIN_CODEX_HOME:-$(service_env WIN_CODEX_HOME)}"
FAST_CODEX_HOME="${FAST_CODEX_HOME:-$(service_env FAST_CODEX_HOME)}"
WIN_CODEX_HOME="${WIN_CODEX_HOME:-/mnt/c/Users/${OWNER_USER}/.codex}"
FAST_CODEX_HOME="${FAST_CODEX_HOME:-/home/${OWNER_USER}/.codex-desktop-fast}"
OWNER_GROUP="$(id -gn "$OWNER_USER")"

log() {
	echo "[codex-fast-home-mount] $*"
}

chmod_desktop_wsl_bins() {
	local target_bins="$FAST_CODEX_HOME/bin/wsl"

	if [[ ! -d "$target_bins" ]]; then
		return
	fi

	log "Ensuring Desktop-managed WSL codex binaries are executable..."
	find "$target_bins" -type f -name codex -exec chmod 0755 {} +
	chown -R "$OWNER_USER:$OWNER_GROUP" "$target_bins"
}

if [[ $EUID -ne 0 ]]; then
	echo "codex-fast-home-mount must run as root." >&2
	exit 1
fi

if [[ ! -d "$(dirname "$WIN_CODEX_HOME")" ]]; then
	echo "Windows home is not mounted yet: $(dirname "$WIN_CODEX_HOME")" >&2
	exit 1
fi

install -d -o "$OWNER_USER" -g "$OWNER_GROUP" -m 0775 "$FAST_CODEX_HOME"
install -d -o "$OWNER_USER" -g "$OWNER_GROUP" -m 0775 "$WIN_CODEX_HOME"

# If the target is already mounted, accept only the expected source.
# This prevents accidental duplicate/stacked bind mounts.
if mountpoint -q "$WIN_CODEX_HOME"; then
	if findmnt -rn --target "$WIN_CODEX_HOME" -o SOURCE | grep -Fq "$FAST_CODEX_HOME"; then
		log "Already mounted: $FAST_CODEX_HOME -> $WIN_CODEX_HOME"
		exit 0
	fi

	echo "Target is already mounted from an unexpected source: $WIN_CODEX_HOME" >&2
	findmnt -T "$WIN_CODEX_HOME" >&2
	exit 1
fi

# Treat the ext4 mirror as the source of truth after the first import.
if ! find "$FAST_CODEX_HOME" -mindepth 1 -print -quit | grep -q .; then
	if find "$WIN_CODEX_HOME" -mindepth 1 -print -quit | grep -q .; then
		log "Fast mirror is empty; importing initial Windows .codex contents..."
		rsync -a --chown="$OWNER_USER:$OWNER_GROUP" \
			"$WIN_CODEX_HOME"/ \
			"$FAST_CODEX_HOME"/
	else
		log "Fast mirror and Windows .codex are empty; mounting empty fast mirror."
	fi
else
	log "Fast mirror already has data; skipping Windows import."
fi

chmod_desktop_wsl_bins

log "Bind mounting fast mirror..."
mount --bind "$FAST_CODEX_HOME" "$WIN_CODEX_HOME"

log "Mounted successfully:"
findmnt -T "$WIN_CODEX_HOME" -o TARGET,SOURCE,FSTYPE
