#!/usr/bin/env bash
set -euo pipefail

OWNER_USER="${CODEX_OWNER_USER:-${SUDO_USER:-$USER}}"
WIN_CODEX_HOME="${WIN_CODEX_HOME:-/mnt/c/Users/${OWNER_USER}/.codex}"
FAST_CODEX_HOME="${FAST_CODEX_HOME:-/home/${OWNER_USER}/.codex-desktop-fast}"
OWNER_GROUP="$(id -gn "$OWNER_USER")"

if [[ $EUID -ne 0 ]]; then
  echo "codex-fast-home-mount must run as root." >&2
  exit 1
fi

if [[ ! -d "$(dirname "$WIN_CODEX_HOME")" ]]; then
  echo "Windows home is not mounted yet: $(dirname "$WIN_CODEX_HOME")" >&2
  exit 1
fi

install -d -o "$OWNER_USER" -g "$OWNER_GROUP" -m 0775 "$FAST_CODEX_HOME"
install -d -o "$OWNER_USER" -g "$OWNER_GROUP" -m 0775 "$WIN_CODEX_HOME"

if findmnt -T "$WIN_CODEX_HOME" -n -o SOURCE | grep -Fq "$FAST_CODEX_HOME"; then
  exit 0
fi

if [[ -z "$(find "$FAST_CODEX_HOME" -mindepth 1 -maxdepth 1 -print -quit)" ]] \
  && [[ -n "$(find "$WIN_CODEX_HOME" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
  rsync -a --chown="$OWNER_USER:$OWNER_GROUP" "$WIN_CODEX_HOME"/ "$FAST_CODEX_HOME"/
fi

mount --bind "$FAST_CODEX_HOME" "$WIN_CODEX_HOME"
